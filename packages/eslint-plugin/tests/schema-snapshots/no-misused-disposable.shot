# TYPES:

type Options = [
  {
    /** Type specifiers of functions whose calls are safe to float. */
    allowForKnownSafeCalls?: (
      | {
          from: 'file';
          name: string | string[];
          path?: string;
        }
      | {
          from: 'lib';
          name: string | string[];
        }
      | {
          from: 'package';
          name: string | string[];
          package: string;
        }
      | string
    )[];
    /** Type specifiers of disposable types that are safe to float. */
    allowForKnownSafeDisposables?: (
      | {
          from: 'file';
          name: string | string[];
          path?: string;
        }
      | {
          from: 'lib';
          name: string | string[];
        }
      | {
          from: 'package';
          name: string | string[];
          package: string;
        }
      | string
    )[];
    /** Whether to ignore `void` expressions. */
    ignoreVoid?: boolean;
  },
];
